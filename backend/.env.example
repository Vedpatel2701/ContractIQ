# ===================================================
# ContractIQ Backend Environment Variables (Example Template)
# ===================================================

PROJECT_NAME="ContractIQ API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment: "development" or "production"
ENVIRONMENT="development"

# Security & Authentication (Required: minimum 32 chars in production)
SECRET_KEY="your-32-character-or-longer-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite example:
DATABASE_URL="sqlite:///./contractiq.db"
# Hosted Neon PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://user:password@ep-xyz.us-east-2.aws.neon.tech/contractiq?sslmode=require"

# AI / LLM Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
DEFAULT_LLM_PROVIDER="gemini"

# OCR Configuration (Optional custom path, auto-discovered on Linux / standard Windows paths if omitted)
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# CORS Configuration (Comma-separated or JSON list of frontend URLs)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
